node_modules/
extractor/.venv/
extractor/graphify-out/

# The reference corpus at the default seed IS committed — that is the point of
# the repository. Corpora rolled at other seeds are not.
data/generated-*/
data/graph-*/

# `npm run generate` writes the answers it resolved to ./config.yaml, and reads
# them back on the next run so a second run repeats the first. That makes it
# one developer's working state, not a repository file: committed, it would
# silently replace the defaults for everyone who clones, and `npm run generate
# --yes` would stop reproducing the reference corpus. The defaults live in
# src/config/schema.ts, which is where they can be reviewed.
/config.yaml

# Companies generated by `npm run generate` land in data/generated/<slug>/.
# They are reproducible from their own config.yaml, so they are not committed.
# The two directories that belong to the reference corpus are.
data/generated/*/
!data/generated/documents/
!data/generated/nx/

# Derived viewer artifacts, ~4 MB, rebuilt by `npm run graph`. graph.json is
# committed because rebuilding it needs Python; these two do not need to be.
data/graph/graph.html
data/graph/graph.cypher
# The assembled landing page. site/ itself is committed; site/_out is the
# deployable tree that `npm run site` builds from it, and site/assets is
# copied there from docs/assets rather than kept twice.
site/_out/
site/assets/

*.log
.DS_Store
