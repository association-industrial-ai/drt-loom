node_modules/
extractor/.venv/
extractor/graphify-out/

# The reference corpus at the default seed IS committed — that is the point of
# the repository. Corpora rolled at other seeds are not.
data/generated-*/
data/graph-*/

# Companies generated by `npm run generate` land in data/generated/<slug>/.
# They are reproducible from their own config.yaml, so they are not committed.
# The two directories that belong to the reference corpus are.
data/generated/*/
!data/generated/documents/
!data/generated/nx/

# Derived viewer artifacts, ~4 MB, rebuilt by `npm run graph`. graph.json is
# committed because rebuilding it needs Python; these two do not need to be.
data/graph/graph.html
data/graph/graph.cypher
*.log
.DS_Store
